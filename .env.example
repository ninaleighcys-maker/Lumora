# Public URL of your deployed Lumora app
APP_URL=https://YOUR-APP.onrender.com

# Managed PostgreSQL database (recommended for public deployment)
# Paste the connection string from your database provider.
DATABASE_URL=

# Email verification (optional for local testing; required for real email delivery)
SMTP_HOST=
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
